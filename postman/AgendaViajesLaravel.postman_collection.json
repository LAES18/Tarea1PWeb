{
  "info": {
    "name": "Agenda de Viajes - Laravel Passport (Guias 1, 2 y 3)",
    "description": "Client Credentials, Password Grant, refresh, logout y autorizacion por scopes para la API de viajes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "oauthUrl", "value": "http://127.0.0.1:8000" },
    { "key": "apiUrl", "value": "http://127.0.0.1:8000/api" },
    { "key": "clientId", "value": "" },
    { "key": "clientSecret", "value": "", "type": "secret" },
    { "key": "passwordClientId", "value": "" },
    { "key": "passwordClientSecret", "value": "", "type": "secret" },
    { "key": "clientToken", "value": "", "type": "secret" },
    { "key": "token", "value": "", "type": "secret" },
    { "key": "refreshToken", "value": "", "type": "secret" },
    { "key": "limitedToken", "value": "", "type": "secret" },
    { "key": "viajeId", "value": "1" }
  ],
  "item": [
    {
      "name": "Guia 1 - Client Credentials",
      "item": [
        {
          "name": "1. Obtener token de aplicacion",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('clientToken', pm.response.json().access_token);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "client_credentials" },
                { "key": "client_id", "value": "{{clientId}}" },
                { "key": "client_secret", "value": "{{clientSecret}}" },
                { "key": "scope", "value": "viajes.read" }
              ]
            },
            "url": "{{oauthUrl}}/oauth/token"
          }
        },
        {
          "name": "2. Probar ruta de cliente",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{apiUrl}}/client/status"
          }
        }
      ]
    },
    {
      "name": "Guia 2 - Password Grant y Refresh",
      "item": [
        {
          "name": "1. Registrar usuario con permisos completos",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.access_token);",
              "  pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alumno Demo\",\n  \"email\": \"alumno@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"scopes\": [\"viajes.read\", \"viajes.write\", \"viajes.delete\", \"fotos.read\"]\n}"
            },
            "url": "{{apiUrl}}/registro"
          }
        },
        {
          "name": "2. Login con permisos completos",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.access_token);",
              "  pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alumno@example.com\",\n  \"password\": \"password123\",\n  \"scopes\": [\"viajes.read\", \"viajes.write\", \"viajes.delete\", \"fotos.read\"]\n}"
            },
            "url": "{{apiUrl}}/login"
          }
        },
        {
          "name": "3. Usuario autenticado",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{apiUrl}}/me"
          }
        },
        {
          "name": "4. Renovar access token",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  pm.collectionVariables.set('token', json.access_token);",
              "  pm.collectionVariables.set('refreshToken', json.refresh_token);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "refresh_token" },
                { "key": "refresh_token", "value": "{{refreshToken}}" },
                { "key": "client_id", "value": "{{passwordClientId}}" },
                { "key": "client_secret", "value": "{{passwordClientSecret}}" },
                { "key": "scope", "value": "viajes.read viajes.write viajes.delete fotos.read" }
              ]
            },
            "url": "{{oauthUrl}}/oauth/token"
          }
        },
        {
          "name": "5. Logout y revocacion",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{apiUrl}}/logout"
          }
        }
      ]
    },
    {
      "name": "Guia 3 - Scopes y CRUD",
      "item": [
        {
          "name": "1. Login solo lectura",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 200) pm.collectionVariables.set('limitedToken', pm.response.json().access_token);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alumno@example.com\",\n  \"password\": \"password123\",\n  \"scopes\": [\"viajes.read\"]\n}"
            },
            "url": "{{apiUrl}}/login"
          }
        },
        {
          "name": "2. Listar viajes - permitido con read",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{limitedToken}}" }],
            "url": "{{apiUrl}}/viajes"
          }
        },
        {
          "name": "3. Crear viaje - 403 con token limitado",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{limitedToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destino\": \"Tokyo\",\n  \"pais\": \"Japon\",\n  \"fecha_inicio\": \"2026-10-01\",\n  \"fecha_fin\": \"2026-10-05\",\n  \"descripcion\": \"Viaje cultural por Tokyo\",\n  \"imagen\": null,\n  \"estado\": \"planeado\"\n}"
            },
            "url": "{{apiUrl}}/viajes"
          }
        },
        {
          "name": "4. Inspeccionar scopes (solo local)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{apiUrl}}/token-info"
          }
        },
        {
          "name": "5. Crear viaje con write",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) pm.collectionVariables.set('viajeId', pm.response.json().id);"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destino\": \"Tokyo\",\n  \"pais\": \"Japon\",\n  \"fecha_inicio\": \"2026-10-01\",\n  \"fecha_fin\": \"2026-10-05\",\n  \"descripcion\": \"Viaje cultural por Tokyo\",\n  \"imagen\": null,\n  \"estado\": \"planeado\"\n}"
            },
            "url": "{{apiUrl}}/viajes"
          }
        },
        {
          "name": "6. Actualizar viaje con write",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"estado\": \"completado\"\n}" },
            "url": "{{apiUrl}}/viajes/{{viajeId}}"
          }
        },
        {
          "name": "7. Eliminar viaje con delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{apiUrl}}/viajes/{{viajeId}}"
          }
        },
        {
          "name": "8. Buscar fotos con fotos.read",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{apiUrl}}/fotos?query=Tokyo&per_page=3"
          }
        }
      ]
    }
  ]
}
